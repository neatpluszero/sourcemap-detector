{
  "manifest_version": 2,
  "name": "Sourcemap Detector",
  "version": "1.0.0",
  "description": "Detects sourcemap leaks on websites. Shows a badge count and lets you view, copy, and export all detected sourcemap links.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "webRequest",
    "webNavigation",
    "activeTab",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "shared/constants.js",
      "shared/utils.js",
      "shared/detector.js",
      "background/background.js",
      "background/background-firefox.js"
    ]
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Sourcemap Detector",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/constants.js",
        "shared/utils.js",
        "shared/detector.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sourcemap-detector@neatpluszero",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
