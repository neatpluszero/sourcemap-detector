{
  "manifest_version": 3,
  "name": "Sourcemap Detector",
  "version": "1.0.0",
  "description": "Detects sourcemap leaks on websites. Shows a badge count and lets you view, copy, and export all detected sourcemap links.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "webRequest",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background-chrome-bundle.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Sourcemap Detector",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/content-bundle.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
